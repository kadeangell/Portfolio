{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kadeangell-com",
  "compatibility_date": "2025-09-02",
  // The site is fully prerendered by `pnpm run build`, so for now the Worker is
  // just static assets. Add `main` + a D1 binding here when the shop needs a backend.
  "assets": {
    "directory": "./dist/client"
  }
}
